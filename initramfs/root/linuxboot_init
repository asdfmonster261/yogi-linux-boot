#!/bin/busybox sh
/bin/busybox --install -s /bin
export PATH=/bin:/sbin:/system/bin
mount -t proc none /proc 2>/dev/null; mount -t sysfs none /sys 2>/dev/null
mount -t devtmpfs none /dev 2>/dev/null; mount -t tmpfs none /tmp 2>/dev/null
mount -t configfs none /sys/kernel/config 2>/dev/null
echo 1 > /proc/sys/kernel/sysrq 2>/dev/null

BLOG=/tmp/boot.log; : > "$BLOG"
ts(){ cut -d' ' -f1 /proc/uptime 2>/dev/null; }
L(){ m="[lb $(ts)] $*"; echo "$m" >>"$BLOG"; echo "$m" >/dev/pmsg0 2>/dev/null; echo "$m" >/dev/kmsg 2>/dev/null; }
ksnap(){ { echo "== ksnap:$1 @$(ts) =="; dmesg 2>/dev/null | grep -iE 'usb [0-9]|xhci|dwc3|scsi|sd [0-9]|\[sd|uas|ext4|EXT4-fs|vs_drm|drm|panel|dpu|card0|I/O error|Attached' | tail -40; } | tee -a "$BLOG" >/dev/pmsg0 2>/dev/null; }

L "INIT $(uname -r) label-detect+display build"

MDIR=/lib/modules; loaded=" "
dep(){ case "$loaded" in *" $1 "*) return;; esac; dl=$(grep "^$MDIR/$1\.ko:" $MDIR/modules.dep 2>/dev/null|cut -d: -f2-)
  for d in $dl; do b=${d##*/}; dep "${b%.ko}"; done
  loaded="$loaded$1 "; insmod "$MDIR/$1.ko" 2>>"$BLOG"; }

dep google_wdt
for n in 0 1 2 3; do d=/dev/watchdog$n; [ -c "$d" ]||continue
  ( exec 9>"$d" 2>/dev/null||exit 0; while :; do printf 1 >&9 2>/dev/null||exit 0; sleep 1; done ) & done
if busybox --list 2>/dev/null | grep -qx watchdog; then for n in 0 1; do [ -c /dev/watchdog$n ] && busybox watchdog -t 10 /dev/watchdog$n 2>/dev/null; done; fi
L "watchdog up ($(ls /dev/watchdog* 2>/dev/null|tr '\n' ' '))"

# main load: USB host stack etc. (skip aoc/gsa/modem/trusty -- proven for USB host / UDC)
p=1; while [ $p -le 4 ]; do prog=0
  while IFS= read -r ko; do case "$ko" in aoc*|gsa*|modem*|trusty*|'') continue;; esac
    b=${ko%.ko}; case "$loaded" in *" $b "*) continue;; esac
    if insmod "$MDIR/$ko" 2>/dev/null; then loaded="$loaded$b "; prog=$((prog+1)); fi
  done < "$MDIR/modules.load"; [ $prog -eq 0 ] && break; p=$((p+1)); done
L "main stack: $(echo $loaded|wc -w) modules up"

# ACM shell (device mode; killed just before switch_root)
G=/sys/kernel/config/usb_gadget/g1
mkdir -p $G/strings/0x409 $G/functions/acm.0 $G/configs/c.1/strings/0x409 2>/dev/null
echo 0x18d1>$G/idVendor 2>/dev/null; echo 0xd001>$G/idProduct 2>/dev/null
echo acm>$G/configs/c.1/strings/0x409/configuration 2>/dev/null
ln -sf $G/functions/acm.0 $G/configs/c.1/ 2>/dev/null
u=$(ls /sys/class/udc 2>/dev/null|head -1); [ -n "$u" ] && echo "$u">$G/UDC 2>/dev/null
( while :; do setsid -c sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1; sleep 1; done ) & ACMPID=$!
L "ACM shell up (UDC=$u)"

# AoC + aocd => USB host role (needed for the drive + dock)
( dep gsa; dep aoc_core; dep gvotable; insmod /lib/modules/aoc_usb_driver.ko 2>/dev/null
  A=/sys/devices/platform/a800000.aoc
  for i in 1 2 3 4 5 6 7 8; do [ "$(cat $A/verify_aoc_responsive 2>/dev/null)" = responsive ] && break; sleep 2; done
  mkdir -p /dev/socket; LD_LIBRARY_PATH=/aoc/lib /aoc/linker64 /aoc/aocd >>"$BLOG" 2>&1 &
  sleep 3; L "aocd started; role=$(cat /sys/class/usb_role/*/role 2>/dev/null|tr '\n' ' ')" ) &

L "READY. Attach charger dock + Arch drive (LABEL=archroot) and LEAVE IT."

# find the ARCH drive by label (never blind-grab sda1 -- internal UFS may be exposed)
find_arch(){ local p
  for p in $(ls -1d /dev/sd[a-z][0-9]* 2>/dev/null); do blkid "$p" 2>/dev/null | grep -q 'archroot' && { echo "$p"; return 0; }; done
  for p in $(ls -1d /dev/sd[a-z][0-9]* 2>/dev/null); do blkid "$p" 2>/dev/null | grep -q 'TYPE="ext4"' && { echo "$p"; return 0; }; done
  return 1; }
last=""; part=""; i=0
while :; do
  cur=$(ls -1d /dev/sd* 2>/dev/null | tr '\n' ' ')
  [ "$cur" != "$last" ] && { L "block: [$cur]"; last="$cur"; }
  part=$(find_arch) && [ -n "$part" ] && break
  [ $i -gt 0 ] && [ $((i%30)) -eq 0 ] && L "waiting ${i}x2s sd=[$cur] role=[$(cat /sys/class/usb_role/*/role 2>/dev/null|tr '\n' ' ')]"
  i=$((i+1)); sleep 2
done
L "ARCH DRIVE = $part [$(blkid $part 2>&1)]"
ksnap pre-mount
mkdir -p /newroot
merr=$(mount "$part" /newroot 2>&1); mrc=$?
[ $mrc -ne 0 ] && { L "mount(auto) rc=$mrc [$merr]; retry ext4"; merr=$(mount -t ext4 "$part" /newroot 2>&1); mrc=$?; }
if [ $mrc -ne 0 ]; then L "MOUNT FAILED rc=$mrc [$merr] -- staying up"; { echo tail; tail -80 "$BLOG"; } >/dev/pmsg0 2>/dev/null; while :; do sleep 30; done; fi
L "MOUNTED $part -> /newroot; root=[$(ls /newroot 2>/dev/null|tr '\n' ' ')]"

# bring up the display pipeline now (drive already mounted) so Arch inherits /dev/dri/card0.
# full fixpoint (skip only modem) loads trusty/tzprot/vs_drm/panel/dpu; aoc/gsa already up.
L "loading display stack..."
q=1; while [ $q -le 5 ]; do prog=0
  while IFS= read -r ko; do case "$ko" in modem*|'') continue;; esac
    bb=$(echo ${ko%.ko}|tr - _); [ -e /sys/module/$bb ] && continue
    insmod "$MDIR/$ko" 2>/dev/null && prog=$((prog+1))
  done < "$MDIR/modules.load"; [ $prog -eq 0 ] && break; q=$((q+1)); done
insmod "$MDIR/vs_drm.ko" 2>/dev/null
ksnap display
L "display: dri=[$(ls /dev/dri 2>/dev/null|tr '\n' ' ')] conn=[$(for s in /sys/class/drm/*/status; do [ -f $s ] && echo $(basename $(dirname $s))=$(cat $s); done 2>/dev/null|grep -iv writeback|tr '\n' ' ')]"

# drive still readable after the display load?
INIT=/sbin/init; [ -e /newroot/sbin/init ] || INIT=/usr/lib/systemd/systemd
if [ -e "/newroot$INIT" ]; then
  for m in proc sys dev; do mkdir -p /newroot/$m; mount --move /$m /newroot/$m 2>/dev/null; done
  L "switch_root -> $INIT ; card0=[$(ls /dev/dri 2>/dev/null)]"
  kill $ACMPID 2>/dev/null
  exec switch_root /newroot "$INIT"
  L "switch_root FAILED rc=$?"
else
  L "INIT missing at /newroot$INIT (drive lost after display load?) -- staying up"
fi
{ echo "== tail @$(ts) =="; tail -100 "$BLOG"; } >/dev/pmsg0 2>/dev/null
while :; do sleep 30; done
